{
  "name": "fineprint",
  "version": "0.1.0",
  "private": true,
  "description": "The unsponsored VPN comparison, with every claim sourced",
  "homepage": "https://fineprint.peng.ly",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/fineprint.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "validate": "node scripts/validate.ts",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "node scripts/new-provider.ts"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/browser": "^11.8.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "flag-icons": "^7.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "satori": "^0.63.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0"
  }
}
